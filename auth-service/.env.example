# 复制为 .env 并填入真实值；不要把 .env 提交到版本库
AUTH_PORT=8083
AUTH_MONGO_URI=mongodb://localhost:27017/auth_service
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 必填：至少 32 字符的随机密钥
AUTH_JWT_SECRET=replace-with-at-least-32-characters-random-secret
AUTH_ACCESS_TTL_MS=1800000
AUTH_REFRESH_TTL_MS=604800000
AUTH_TICKET_TTL_MS=300000
AUTH_REDIS_PREFIX=auth:

# Refresh Token HttpOnly Cookie（浏览器端 refresh 不再落 localStorage）
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_NAME=auth_refresh
AUTH_COOKIE_PATH=/api/auth
AUTH_COOKIE_DOMAIN=
# 生产 HTTPS 环境必须置 true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Strict

# SSO 中央会话（统一登录页 /sso/login）
AUTH_SSO_SESSION_ENABLED=true
AUTH_SSO_SESSION_TTL_MS=28800000
AUTH_SSO_SESSION_COOKIE_NAME=auth_sso
AUTH_SSO_SESSION_COOKIE_DOMAIN=
AUTH_SSO_SESSION_COOKIE_SECURE=false
AUTH_SSO_SESSION_COOKIE_SAMESITE=Lax

# SSO 客户端密钥与回跳地址
AUTH_CLIENT_WEB_SECRET=replace-web-client-secret
AUTH_WEB_REDIRECT_URI=http://localhost:5173/sso/callback
AUTH_CLIENT_APP_SECRET=replace-app-client-secret
AUTH_APP_REDIRECT_URI=myapp://sso/callback
AUTH_CLIENT_MINI_SECRET=replace-mini-client-secret
AUTH_MINI_REDIRECT_URI=mini://sso/callback

# 内部服务 HMAC 密钥
AUTH_SERVICE_PLATFORM_SECRET=replace-platform-secret
AUTH_SERVICE_DTM_SECRET=replace-dtm-secret
AUTH_SERVICE_PROXY_SECRET=replace-proxy-secret

# 微信小程序凭证（仅后端持有）
WECHAT_APPID=replace-with-real-appid
WECHAT_APPSECRET=replace-with-real-appsecret
