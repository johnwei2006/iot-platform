# 生产环境
VITE_APP_ENV=production
VITE_APP_API_BASE_URL=https://api.example.com
# 需替换为实际 auth-service 地址，或通过 Nginx 与业务接口同域反代后改为 /
VITE_APP_AUTH_API_BASE_URL=https://auth.example.com
# 统一登录页地址（需向 auth-service 注册同一个 web 客户端 redirect-uri）
VITE_APP_SSO_LOGIN_URL=
# SSO 兑票客户端密钥，须与 auth-service 的 AUTH_CLIENT_WEB_SECRET 一致
VITE_APP_AUTH_CLIENT_SECRET=
VITE_APP_TIMEOUT=15000
