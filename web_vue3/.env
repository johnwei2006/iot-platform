# 前端运行环境变量（Vite 以 VITE_ 前缀注入）
# 业务接口：/api 由 Vite 代理到 platform_java（见 vite.config.ts）
VITE_APP_API_BASE_URL=/
# 鉴权接口：直连 auth-service；开发走 /auth-api 代理，生产用独立域名或同域反代
VITE_APP_AUTH_API_BASE_URL=/auth-api
# 系统管理接口：admin-service；开发走 /admin-api 代理，生产同域反代
VITE_APP_ADMIN_API_BASE_URL=/admin-api
# 统一登录页地址（auth-service 内置页面），留空则不展示 SSO 入口。
# 开发：http://localhost:8083/sso/login 或走代理 /auth-api/sso/login；生产：同域反代 /auth-api/sso/login
VITE_APP_SSO_LOGIN_URL=
# SSO 兑票客户端密钥，须与 auth-service 的 AUTH_CLIENT_WEB_SECRET 一致
VITE_APP_AUTH_CLIENT_SECRET=
VITE_APP_TIMEOUT=15000
VITE_APP_TITLE=IoT 平台管理控制台
