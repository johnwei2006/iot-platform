# admin-service 环境变量示例
ADMIN_PORT=8084
ADMIN_MONGO_URI=mongodb://localhost:27017/admin_service

# 与 auth-service 共享的 Redis（撤销检查：auth:blacklist:<jti> / auth:userver:<id>）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# auth-service 地址（JWKS 本地验签 + 远程回退 + 内部 HMAC 调用）
AUTH_SERVICE_BASE_URL=http://localhost:8083
ADMIN_AUTH_JWKS_URL=
ADMIN_AUTH_JWKS_REFRESH_MS=300000

# 内部服务 HMAC 身份；密钥必须与 auth-service 的 AUTH_SERVICE_ADMIN_SECRET 完全一致
AUTH_SERVICE_ADMIN_SECRET=replace-with-same-secret-as-auth-service

# iss/aud 与 auth-service 保持一致
# AUTH_JWT_ISSUER=iot-auth
# AUTH_JWT_AUDIENCE=iot-platform

# 撤销检查
ADMIN_REVOCATION_CHECK=true
ADMIN_REVOCATION_CACHE_TTL_MS=15000
ADMIN_REVOCATION_FAIL_OPEN=true

# 初始化数据（幂等）
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@123456
ADMIN_ROOT_ORG_CODE=0001
ADMIN_ROOT_ORG_NAME=总部
